{
  "name": "@local/dsh-token-furnace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "白烧 token：反复认真思考没有意义的问题，跑够轮数或花够钱自动停，设置里有控制中心。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
